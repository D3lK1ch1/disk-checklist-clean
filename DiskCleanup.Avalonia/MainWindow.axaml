<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DiskCleanup.Avalonia"
        x:Class="DiskCleanup.Avalonia.MainWindow"
        Title="disk-cleanup"
        Width="900" Height="600">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="120" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" />
      <TextBlock Text="Filter by risk:" Margin="12,0,0,0" VerticalAlignment="Center" />
      <ComboBox x:Name="RiskFilterCombo" Width="120"
                SelectionChanged="RiskFilterCombo_SelectionChanged">
        <ComboBoxItem Content="All" />
        <ComboBoxItem Content="SAFE" />
        <ComboBoxItem Content="REVIEW" />
        <ComboBoxItem Content="INFO" />
      </ComboBox>
      <TextBlock x:Name="StatusText" Text="Not scanned yet." Margin="12,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Results grid: checkbox column drives real per-row selection state (CheckItemViewModel.IsSelected) -->
    <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False"
              IsReadOnly="False" SelectionMode="Extended" RowHeight="28"
              x:DataType="local:CheckItemViewModel"
              SelectionChanged="ItemsGrid_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="40">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="local:CheckItemViewModel">
              <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}"
                        IsEnabled="{Binding CanSelect}"
                        HorizontalAlignment="Center"
                        Click="ItemCheckBox_Click" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Item" Binding="{Binding Label}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" IsReadOnly="True" />
        <DataGridTextColumn Header="Risk" Binding="{Binding Risk}" Width="90" IsReadOnly="True" />
        <DataGridTextColumn Header="Action" Binding="{Binding ActionDescription}" Width="130" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Details: full path + Reason for the selected row, same purpose as WPF's DetailsText -->
    <Border Grid.Row="2" BorderThickness="1" Margin="0,10,0,0" Padding="8">
      <ScrollViewer MaxHeight="100">
        <TextBox x:Name="DetailsText" TextWrapping="Wrap" IsReadOnly="True"
                 BorderThickness="0" Background="Transparent"
                 Text="Select an item to see its full path and why it's categorized that way." />
      </ScrollViewer>
    </Border>

    <!-- Action bar -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,10,0,10">
      <Button x:Name="SelectAllSafeButton" Content="Select all SAFE" Click="SelectAllSafeButton_Click" />
      <Button x:Name="ClearSelectionButton" Content="Clear selection" Click="ClearSelectionButton_Click" />
      <Button x:Name="CleanButton" Content="Clean Selected" Click="CleanButton_Click" />
      <TextBlock x:Name="FreeSpaceText" Margin="12,0,0,0" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Log / warnings -->
    <TextBox x:Name="LogBox" Grid.Row="4" IsReadOnly="True" TextWrapping="Wrap"
             FontFamily="Consolas" AcceptsReturn="True" />
  </Grid>
</Window>
