<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiskCleanup.Avalonia.MainWindow"
        Title="disk-cleanup"
        Width="900" Height="600">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
      <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" />
      <TextBlock x:Name="StatusText" Text="Not scanned yet." VerticalAlignment="Center" />
    </StackPanel>
    <ListBox x:Name="ItemsList" />
  </DockPanel>
</Window>
