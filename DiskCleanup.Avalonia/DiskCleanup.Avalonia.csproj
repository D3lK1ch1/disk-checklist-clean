<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- SDK does not auto-define a per-TFM preprocessor symbol (verified via
       `dotnet msbuild -getProperty:DefineConstants` - both TFMs come back
       with only TRACE;DEBUG) - so PlatformSetup.cs needs its own explicit
       symbol to branch on. -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" Condition="Exists('Assets')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskCleanup.Core\DiskCleanup.Core.csproj" />
    <ProjectReference Include="..\DiskCleanup.Core.Windows\DiskCleanup.Core.Windows.csproj" Condition="'$(TargetFramework)'=='net10.0-windows'" />
    <ProjectReference Include="..\DiskCleanup.Core.Mac\DiskCleanup.Core.Mac.csproj" />
  </ItemGroup>

</Project>
